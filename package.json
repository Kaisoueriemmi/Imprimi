{
  "name": "printbox",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres minio minio-init",
    "db:migrate": "pnpm --filter @printbox/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @printbox/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
