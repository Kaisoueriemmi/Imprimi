{
  "name": "@printbox/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@printbox/shared": "workspace:*",
    "@prisma/client": "~6.19.3",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prisma": "~6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
