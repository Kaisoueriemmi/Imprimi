# Local development (`pnpm dev`) with `pnpm db:up` running. Copy to apps/api/.env
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://printbox:printbox@localhost:5432/printbox

PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# 48+ random bytes: openssl rand -base64 48
QR_TOKEN_SECRET=change-me-generate-a-long-random-secret-please

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=printbox
S3_ACCESS_KEY_ID=printbox
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true

# Optional, used once by `pnpm db:seed` (generated and printed when absent).
# SEED_ADMIN_EMAIL=admin@printbox.local
# SEED_ADMIN_PASSWORD=
# SEED_KIOSK_API_KEY=
# SEED_KIOSK_DISPLAY_KEY=
# SEED_KIOSK_PRINTER_NAME=
