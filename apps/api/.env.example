# Local development (`pnpm dev`) with `pnpm db:up` running. Copy to apps/api/.env
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

DATABASE_URL=postgresql://printbox:printbox@localhost:5432/printbox

PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# 48+ random bytes: openssl rand -base64 48
QR_TOKEN_SECRET=change-me-generate-a-long-random-secret-please
# Another, different secret for customer session tokens.
SESSION_TOKEN_SECRET=change-me-another-long-random-secret-please

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=printbox
S3_ACCESS_KEY_ID=printbox
S3_SECRET_ACCESS_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
# Endpoint reachable by the print agent for pre-signed URLs (defaults to S3_ENDPOINT).
# S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000

# PDF conversion worker (in-process in dev). Without LibreOffice/Poppler installed,
# DOCX uploads fail and PDFs have no thumbnail; Docker images include both.
CONVERSION_WORKER_ENABLED=true
CONVERSION_CONCURRENCY=2
LIBREOFFICE_PATH=soffice
PDFTOPPM_PATH=pdftoppm

# Prices are rounded up to this many millimes (smallest coin the coin machine handles).
PRICE_ROUNDING_MILLIMES=100
# Demo only: allows printing without paying (refused when NODE_ENV=production).
PAYMENT_FREE_MODE=false
# Periodic tasks (unpaid job expiry, coin machine reservations): one process only.
SCHEDULER_ENABLED=true

# Optional, used once by `pnpm db:seed` (generated and printed when absent).
# SEED_ADMIN_EMAIL=admin@printbox.local
# SEED_ADMIN_PASSWORD=
# SEED_KIOSK_API_KEY=
# SEED_KIOSK_DISPLAY_KEY=
# SEED_KIOSK_PRINTER_NAME=
