# docker-compose.yml variables. Copy to .env and change every "change-me" value.
NODE_ENV=production
LOG_LEVEL=info

POSTGRES_PASSWORD=printbox
# Host port; change it if a local PostgreSQL already listens on 5432.
POSTGRES_PORT=5432

MINIO_ROOT_USER=printbox
MINIO_ROOT_PASSWORD=change-me-minio-secret
S3_BUCKET=printbox

# 48+ random bytes: openssl rand -base64 48
QR_TOKEN_SECRET=change-me-generate-a-long-random-secret-please

# URL the customers' phones open (encoded in the QR code), and the origins allowed by CORS.
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
